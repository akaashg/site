---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Starfield from '../components/Starfield.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** Set true on pages that shouldn't be indexed (none currently, kept for completeness). */
  noindex?: boolean;
  /** Site-root-relative path to a 1200x630 raster share card. */
  ogImage?: string;
}

const { title, description, noindex = false, ogImage = '/images/og-default.png' } = Astro.props;
const siteUrl = Astro.site ?? new URL('/', Astro.url);
const pageTitle = title === 'Akaash Garg' ? title : `${title} · Akaash Garg`;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

/* Social crawlers reject relative og:image paths — these must be absolute. */
const ogImageURL = new URL(ogImage, siteUrl);

/* The Person node wants an actual photo of the person, not the share card. */
const portraitURL = new URL('/images/profile-picture/akaash-garg-portrait-560.webp', siteUrl);

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#akaash`,
      name: 'Akaash Garg',
      url: siteUrl.toString(),
      image: {
        '@type': 'ImageObject',
        url: portraitURL.toString(),
        width: 560,
        height: 896,
        caption: 'Akaash Garg, lead XR engineer',
      },
      jobTitle: 'Lead XR Engineer',
      email: 'mailto:akaash.garg@gmail.com',
      description,
      knowsAbout: [
        'Extended Reality',
        'Virtual Reality Development',
        'Augmented Reality Development',
        'Unity 3D',
        'Multiplayer Networking',
        'Real-time Rendering Performance',
      ],
      sameAs: ['https://www.linkedin.com/in/akaashgarg/', 'https://2dudestudios.com/'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}#services`,
      name: 'Akaash Garg — XR Engineering',
      url: new URL('/services/', siteUrl).toString(),
      image: ogImageURL.toString(),
      description:
        'Enterprise XR engineering: Unity VR/AR product delivery, multiplayer systems, and standalone-headset performance optimization.',
      areaServed: 'Worldwide',
      availableLanguage: ['English', 'Hindi'],
      provider: { '@id': `${siteUrl}#akaash` },
      serviceType: [
        'VR application development',
        'AR application development',
        'Multiplayer systems engineering',
        'XR performance optimization',
        'Game development',
        'Enterprise XR training products',
        'Gamified training solutions',
        'Technical leadership and XR consulting',
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#05060d" />
    <meta property="og:site_name" content="Akaash Garg" />

    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Akaash Garg — Lead XR Engineer. Enterprise XR, multiplayer systems, and 72fps standalone." />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="generator" content={Astro.generator} />
    <!-- set:html is required: a <script> with a type attribute is treated as
         inline by Astro, and inline scripts do not interpolate expressions. -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Starfield />
    <Header />
    <main id="main" class="relative z-10 flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealTargets = Array.from(document.querySelectorAll('[data-animate]'));

      if (prefersReducedMotion) {
        revealTargets.forEach((target) => {
          if (target instanceof HTMLElement) {
            target.classList.add('is-visible');
          }
        });
      } else if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2, rootMargin: '0px 0px -8% 0px' }
        );

        revealTargets.forEach((target) => {
          if (target instanceof HTMLElement) {
            const delay = Number(target.dataset.animateDelay ?? 0);
            if (Number.isFinite(delay) && delay > 0) {
              target.style.transitionDelay = `${delay}ms`;
            }
            observer.observe(target);
          }
        });
      } else {
        revealTargets.forEach((target) => {
          if (target instanceof HTMLElement) {
            target.classList.add('is-visible');
          }
        });
      }

      /* Case-study clips are silent loops. They carry no autoplay attribute,
         so nothing moves until this runs -- a visitor who asked for less
         motion gets the poster frame and controls instead. */
      document.querySelectorAll('video[data-autoplay]').forEach((clip) => {
        if (!(clip instanceof HTMLVideoElement)) return;
        if (prefersReducedMotion) {
          clip.controls = true;
          return;
        }
        clip.muted = true;
        /* Autoplay can still be refused (data saver, low power); fall back to
           controls rather than leaving a frozen poster with no way to play.
           The promise also rejects transiently while the first frames load
           even though playback then starts, so only surface controls if the
           clip is genuinely still paused. */
        clip.play().catch(() => {
          if (clip.paused) clip.controls = true;
        });
      });

      /* YouTube embeds are swapped in on click rather than shipped in the
         markup, so opening a case study makes no request to YouTube and sets
         no third-party cookie. nocookie host for the same reason. */
      document.querySelectorAll('button[data-youtube]').forEach((facade) => {
        if (!(facade instanceof HTMLElement)) return;
        facade.addEventListener(
          'click',
          () => {
            const id = facade.dataset.youtube;
            if (!id) return;
            const frame = document.createElement('iframe');
            frame.className = 'yt-frame';
            frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
            frame.title = facade.getAttribute('aria-label') ?? 'Video';
            frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
            frame.allowFullscreen = true;
            facade.replaceWith(frame);
          },
          { once: true },
        );
      });
    </script>
  </body>
</html>
