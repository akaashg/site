---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Starfield from '../components/Starfield.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** Set true on pages that shouldn't be indexed (none currently, kept for completeness). */
  noindex?: boolean;
  /** Site-root-relative path to a 1200x630 raster share card. */
  ogImage?: string;
}

const { title, description, noindex = false, ogImage = '/images/og-default.png' } = Astro.props;
const siteUrl = Astro.site ?? new URL('/', Astro.url);
const pageTitle = title === 'Akaash Garg' ? title : `${title} · Akaash Garg`;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

/* Social crawlers reject relative og:image paths — these must be absolute. */
const ogImageURL = new URL(ogImage, siteUrl);

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#akaash`,
      name: 'Akaash Garg',
      url: siteUrl.toString(),
      image: ogImageURL.toString(),
      jobTitle: 'Lead XR Engineer',
      email: 'mailto:akaash.garg@gmail.com',
      description,
      knowsAbout: [
        'Extended Reality',
        'Virtual Reality Development',
        'Augmented Reality Development',
        'Unity 3D',
        'Multiplayer Networking',
        'Real-time Rendering Performance',
      ],
      sameAs: ['https://www.linkedin.com/in/akaashgarg/', 'https://2dudestudios.com/'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}#services`,
      name: 'Akaash Garg — XR Engineering',
      url: new URL('/services/', siteUrl).toString(),
      image: ogImageURL.toString(),
      description:
        'Enterprise XR engineering: Unity VR/AR product delivery, multiplayer systems, and standalone-headset performance optimization.',
      areaServed: 'Worldwide',
      availableLanguage: ['English', 'Hindi'],
      provider: { '@id': `${siteUrl}#akaash` },
      serviceType: [
        'VR application development',
        'AR application development',
        'Multiplayer systems engineering',
        'XR performance optimization',
        'Game development',
        'Enterprise XR training products',
        'Gamified training solutions',
        'Technical leadership and XR consulting',
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#05060d" />
    <meta property="og:site_name" content="Akaash Garg" />

    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Akaash Garg — Lead XR Engineer. Enterprise XR, multiplayer systems, and 90fps standalone." />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="generator" content={Astro.generator} />
    <!-- set:html is required: a <script> with a type attribute is treated as
         inline by Astro, and inline scripts do not interpolate expressions. -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Starfield />
    <Header />
    <main id="main" class="relative z-10 flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealTargets = Array.from(document.querySelectorAll('[data-animate]'));

      if (prefersReducedMotion) {
        revealTargets.forEach((target) => {
          if (target instanceof HTMLElement) {
            target.classList.add('is-visible');
          }
        });
      } else if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2, rootMargin: '0px 0px -8% 0px' }
        );

        revealTargets.forEach((target) => {
          if (target instanceof HTMLElement) {
            const delay = Number(target.dataset.animateDelay ?? 0);
            if (Number.isFinite(delay) && delay > 0) {
              target.style.transitionDelay = `${delay}ms`;
            }
            observer.observe(target);
          }
        });
      } else {
        revealTargets.forEach((target) => {
          if (target instanceof HTMLElement) {
            target.classList.add('is-visible');
          }
        });
      }
    </script>
  </body>
</html>
