---
/**
 * Privacy-first analytics with conversion-event tracking.
 *
 * Inert until PROVIDER is set: no script loads, no `track()` calls go
 * anywhere, and the site ships exactly as it does today. Set PROVIDER plus the
 * matching config below to switch it on.
 *
 * Every provider here is cookieless, so no consent banner is required under
 * GDPR or India's DPDP Act. Google Analytics would change that.
 */

type Provider = 'none' | 'plausible' | 'umami' | 'cloudflare';

/* `as Provider` keeps the union type: a plain annotated const narrows to the
   literal 'none', which makes the other branches unreachable to TypeScript. */
const PROVIDER = 'umami' as Provider;

const CONFIG = {
  /** Plausible: the domain exactly as registered in your dashboard. */
  plausible: {
    domain: 'akaashgarg.com',
    src: 'https://plausible.io/js/script.outbound-links.tagged-events.js',
  },
  /**
   * Umami Cloud. Website ID from Settings -> Websites.
   *
   * `domains` restricts collection to the production host, so local dev, the
   * workers.dev URL, and preview builds never appear in the stats.
   */
  umami: {
    websiteId: '9c22491d-8e73-4d82-8a9b-42b057d9acb8',
    src: 'https://cloud.umami.is/script.js',
    domains: 'akaashgarg.com',
  },
  /** Cloudflare Web Analytics: the token from the dashboard beacon snippet. */
  cloudflare: {
    token: '',
  },
};
---

{
  PROVIDER === 'plausible' && (
    <script is:inline defer data-domain={CONFIG.plausible.domain} src={CONFIG.plausible.src} />
  )
}

{
  PROVIDER === 'umami' && CONFIG.umami.websiteId && (
    <script
      is:inline
      defer
      data-website-id={CONFIG.umami.websiteId}
      data-domains={CONFIG.umami.domains}
      src={CONFIG.umami.src}
    />
  )
}

{
  PROVIDER === 'cloudflare' && CONFIG.cloudflare.token && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${CONFIG.cloudflare.token}"}`}
    />
  )
}

<script is:inline>
  (() => {
    /**
     * First-touch campaign attribution.
     *
     * Umami tags UTM parameters onto the pageview they arrive on, so an event
     * fired later in the visit -- a booking click, a submitted brief -- lands
     * with no campaign attached and can't be credited to the link that drove
     * it. Reading them once and merging them into every event closes that gap.
     */
    const CAMPAIGN_KEY = 'ag:campaign';
    const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];

    const campaign = (() => {
      try {
        /* First touch wins: the campaign that opened the session keeps the
           credit, so a later link with its own tags can't overwrite it. */
        const stored = sessionStorage.getItem(CAMPAIGN_KEY);
        if (stored) return JSON.parse(stored);

        const params = new URLSearchParams(window.location.search);
        const found = {};
        UTM_KEYS.forEach((key) => {
          const value = params.get(key);
          /* Capped: these become dashboard dimensions, and one mangled link
             with a 300-character value would earn its own useless row. */
          if (value) found[key] = value.slice(0, 100);
        });

        if (!Object.keys(found).length) return {};
        sessionStorage.setItem(CAMPAIGN_KEY, JSON.stringify(found));
        return found;
      } catch {
        /* sessionStorage throws in private mode and with storage blocked. */
        return {};
      }
    })();

    /**
     * Provider-agnostic event shim. Everything on the site calls
     * `window.track(name, props)`; this forwards to whichever provider is
     * loaded and silently no-ops when none is.
     */
    window.track = function track(name, props) {
      try {
        /* An event's own props win, in the unlikely case of a name collision. */
        const payload = { ...campaign, ...props };
        const data = Object.keys(payload).length ? payload : undefined;

        if (typeof window.plausible === 'function') {
          window.plausible(name, data ? { props: data } : undefined);
        } else if (window.umami && typeof window.umami.track === 'function') {
          window.umami.track(name, data);
        }
      } catch {
        /* Analytics must never break a page interaction. */
      }
    };

    /* Auto-track the conversion path so pages don't each need wiring. */
    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest('a') : null;
      if (!link) return;
      const href = link.getAttribute('href') || '';

      if (href.includes('cal.com')) {
        window.track('Booking click');
      } else if (href.startsWith('mailto:')) {
        window.track('Email click');
      } else if (href.endsWith('.pdf')) {
        window.track('Resume download');
      } else if (href.includes('play.google.com') || href.includes('steampowered.com')) {
        window.track('Store link click', { store: href.includes('steam') ? 'Steam' : 'Google Play' });
      } else if (href.includes('linkedin.com')) {
        window.track('LinkedIn click');
      }
    });
  })();
</script>
