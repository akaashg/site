---
export interface Props {
  size?: number;
}

const { size = 340 } = Astro.props;
---

<figure class="orbit-viewer mx-auto" style={`--viewer-size: ${size}px`}>
  <canvas
    class="orbit-canvas"
    role="img"
    tabindex="0"
    aria-label="Interactive orbital scene: a wireframe planet with a tilted ring system and three moons. Drag or use the arrow keys to orbit, scroll to zoom."
  ></canvas>
  <div class="viewer-hud" aria-hidden="true">
    <span>XR / orbital sandbox</span>
    <span class="viewer-instruction">Drag to orbit</span>
  </div>
</figure>

<script is:inline type="module">
  import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.js';

  const canvas = document.querySelector('.orbit-canvas');
  if (canvas instanceof HTMLCanvasElement) {
    const host = canvas.parentElement;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let renderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    } catch {
      canvas.closest('.orbit-viewer')?.classList.add('is-fallback');
    }

    if (renderer) {
      const initialSize = host?.clientWidth ?? 340;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
      renderer.setSize(initialSize, initialSize, false);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 200);
      const target = new THREE.Vector3(0, 0, 0);
      let radius = 9.4;
      let azimuth = -0.6;
      let elevation = 0.34;

      const world = new THREE.Group();
      scene.add(world);

      /* Deep field — a shell of stars that drifts independently of the planet. */
      const STAR_COUNT = 850;
      const starPositions = new Float32Array(STAR_COUNT * 3);
      for (let i = 0; i < STAR_COUNT; i += 1) {
        const r = 20 + Math.random() * 26;
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);
        starPositions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
        starPositions[i * 3 + 1] = r * Math.cos(phi);
        starPositions[i * 3 + 2] = r * Math.sin(phi) * Math.sin(theta);
      }
      const starGeometry = new THREE.BufferGeometry();
      starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
      const starField = new THREE.Points(
        starGeometry,
        new THREE.PointsMaterial({ color: 0xdbeafe, size: 0.24, sizeAttenuation: true, transparent: true, opacity: 0.85 }),
      );
      scene.add(starField);

      /* Planet — dark core, wireframe crust, violet atmosphere. */
      const planet = new THREE.Group();
      world.add(planet);
      planet.add(
        new THREE.Mesh(
          new THREE.IcosahedronGeometry(1.6, 3),
          new THREE.MeshBasicMaterial({ color: 0x0b1120 }),
        ),
        new THREE.Mesh(
          new THREE.IcosahedronGeometry(1.63, 2),
          new THREE.MeshBasicMaterial({ color: 0x7dd3fc, wireframe: true, transparent: true, opacity: 0.5 }),
        ),
        new THREE.Mesh(
          new THREE.SphereGeometry(1.82, 32, 32),
          new THREE.MeshBasicMaterial({ color: 0x7c3aed, transparent: true, opacity: 0.14, side: THREE.BackSide }),
        ),
      );

      /* Ring system, tilted off the orbital plane. */
      const rings = new THREE.Group();
      rings.rotation.set(-1.4, 0, 0.42);
      world.add(rings);
      [
        [2.42, 2.58, 0.5, 0x67e8f9],
        [2.72, 2.78, 0.3, 0xa78bfa],
        [2.95, 3.18, 0.4, 0x67e8f9],
      ].forEach(([inner, outer, opacity, color]) => {
        rings.add(
          new THREE.Mesh(
            new THREE.RingGeometry(inner, outer, 128),
            new THREE.MeshBasicMaterial({ color, transparent: true, opacity, side: THREE.DoubleSide }),
          ),
        );
      });

      /* Moons on inclined orbits, each with a traced path. */
      const MOONS = [
        { distance: 4.0, size: 0.2, speed: 0.42, tilt: 0.34, phase: 0, color: 0xf0abfc },
        { distance: 5.2, size: 0.14, speed: -0.29, tilt: -0.62, phase: 2.1, color: 0x67e8f9 },
        { distance: 6.5, size: 0.1, speed: 0.19, tilt: 0.92, phase: 4.0, color: 0xa78bfa },
      ];
      const moons = MOONS.map((spec) => {
        const orbit = new THREE.Group();
        orbit.rotation.set(-Math.PI / 2 + spec.tilt, 0, spec.tilt * 0.5);
        world.add(orbit);

        const points = new THREE.EllipseCurve(0, 0, spec.distance, spec.distance, 0, Math.PI * 2)
          .getPoints(96)
          .map((point) => new THREE.Vector3(point.x, point.y, 0));
        orbit.add(
          new THREE.LineLoop(
            new THREE.BufferGeometry().setFromPoints(points),
            new THREE.LineBasicMaterial({ color: spec.color, transparent: true, opacity: 0.18 }),
          ),
        );

        const body = new THREE.Mesh(
          new THREE.IcosahedronGeometry(spec.size, 1),
          new THREE.MeshBasicMaterial({ color: spec.color, wireframe: true, transparent: true, opacity: 0.9 }),
        );
        orbit.add(body);
        return { body, spec };
      });

      function updateCamera() {
        camera.position.set(
          radius * Math.cos(elevation) * Math.sin(azimuth),
          radius * Math.sin(elevation),
          radius * Math.cos(elevation) * Math.cos(azimuth),
        );
        camera.lookAt(target);
      }

      function draw() {
        updateCamera();
        renderer.render(scene, camera);
      }

      /* Pointer + keyboard orbit control. */
      let pointerDown = false;
      let lastX = 0;
      let lastY = 0;

      canvas.addEventListener('pointerdown', (event) => {
        pointerDown = true;
        lastX = event.clientX;
        lastY = event.clientY;
        canvas.setPointerCapture(event.pointerId);
      });

      canvas.addEventListener('pointermove', (event) => {
        if (!pointerDown) return;
        azimuth -= (event.clientX - lastX) * 0.009;
        elevation = THREE.MathUtils.clamp(elevation + (event.clientY - lastY) * 0.009, -0.55, 1.15);
        lastX = event.clientX;
        lastY = event.clientY;
        if (reduceMotion) draw();
      });

      const releasePointer = (event) => {
        pointerDown = false;
        if (event?.pointerId !== undefined && canvas.hasPointerCapture(event.pointerId)) {
          canvas.releasePointerCapture(event.pointerId);
        }
      };
      canvas.addEventListener('pointerup', releasePointer);
      canvas.addEventListener('pointercancel', releasePointer);
      /* Fallback: a release outside the canvas must still end the drag. */
      window.addEventListener('pointerup', releasePointer);
      window.addEventListener('blur', () => { pointerDown = false; });

      canvas.addEventListener('wheel', (event) => {
        event.preventDefault();
        radius = THREE.MathUtils.clamp(radius + event.deltaY * 0.008, 5.4, 15);
        if (reduceMotion) draw();
      }, { passive: false });

      canvas.addEventListener('keydown', (event) => {
        const step = 0.12;
        if (event.key === 'ArrowLeft') azimuth += step;
        else if (event.key === 'ArrowRight') azimuth -= step;
        else if (event.key === 'ArrowUp') elevation = THREE.MathUtils.clamp(elevation + step, -0.55, 1.15);
        else if (event.key === 'ArrowDown') elevation = THREE.MathUtils.clamp(elevation - step, -0.55, 1.15);
        else return;
        event.preventDefault();
        if (reduceMotion) draw();
      });

      /* Animation loop, paused when off-screen or the tab is hidden. */
      const clock = new THREE.Clock();
      let elapsed = 0;
      let frameId = 0;
      let onScreen = true;

      function frame() {
        const delta = Math.min(clock.getDelta(), 0.05);
        elapsed += delta;

        planet.rotation.y += delta * 0.12;
        rings.rotation.z += delta * 0.05;
        starField.rotation.y += delta * 0.006;
        if (!pointerDown) azimuth += delta * 0.03;

        moons.forEach(({ body, spec }) => {
          const angle = spec.phase + elapsed * spec.speed;
          body.position.set(Math.cos(angle) * spec.distance, Math.sin(angle) * spec.distance, 0);
          body.rotation.x += delta * 0.6;
          body.rotation.y += delta * 0.4;
        });

        draw();
        frameId = requestAnimationFrame(frame);
      }

      function start() {
        if (reduceMotion || frameId) return;
        clock.getDelta();
        frameId = requestAnimationFrame(frame);
      }

      function stop() {
        cancelAnimationFrame(frameId);
        frameId = 0;
      }

      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          onScreen = entries[0].isIntersecting;
          if (onScreen && !document.hidden) start();
          else stop();
        }, { threshold: 0 }).observe(canvas);
      } else {
        start();
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden || !onScreen) stop();
        else start();
      });

      if (host) {
        new ResizeObserver(() => {
          const nextSize = host.clientWidth || initialSize;
          renderer.setSize(nextSize, nextSize, false);
          camera.aspect = 1;
          camera.updateProjectionMatrix();
          draw();
        }).observe(host);
      }

      /* Seed the moons so the static (reduced-motion) frame isn't all at angle 0. */
      moons.forEach(({ body, spec }) => {
        body.position.set(Math.cos(spec.phase) * spec.distance, Math.sin(spec.phase) * spec.distance, 0);
      });
      draw();
      start();
    }
  }
</script>

<style>
  .orbit-viewer {
    position: relative;
    width: min(100%, var(--viewer-size));
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid rgb(125 211 252 / 0.15);
    background:
      radial-gradient(circle at 50% 45%, rgb(30 41 59 / 0.7), rgb(5 6 13 / 0.15) 62%),
      radial-gradient(circle at 78% 18%, rgb(124 58 237 / 0.22), transparent 45%);
  }

  .orbit-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }

  .orbit-canvas:active { cursor: grabbing; }

  .orbit-viewer.is-fallback .orbit-canvas { display: none; }

  .viewer-hud {
    position: absolute;
    inset: auto 1rem 0.9rem;
    display: flex;
    justify-content: space-between;
    font: 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(186 230 253 / 0.7);
    pointer-events: none;
  }

  .viewer-instruction { color: rgb(167 139 250 / 0.72); }

  @media (prefers-reduced-motion: reduce) {
    .viewer-instruction { display: none; }
  }
</style>
