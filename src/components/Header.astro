---
const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-[#05060d]/95 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a
      href="/"
      class="font-sans text-base font-semibold text-paper no-underline transition hover:text-signal"
    >
      Akaash Garg
    </a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap items-center gap-4 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'rounded-full px-3 py-2 no-underline transition duration-200 hover:text-signal hover:bg-white/5',
                  isActive(link.href)
                    ? 'text-paper bg-white/5'
                    : 'text-muted',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/contact/"
            class="rounded-full border border-signal/20 bg-signal/10 px-4 py-2 text-sm font-semibold text-paper transition hover:bg-signal/15 hover:text-paper"
          >
            Work with me
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
