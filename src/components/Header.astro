---
const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-[#05060d]/95 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a
      href="/"
      class="font-sans text-base font-semibold text-paper no-underline transition hover:text-signal"
    >
      Akaash Garg
    </a>

    <!-- Below `md` the five links plus the CTA wrap onto three rows, so a
         sticky header would eat ~15% of a phone viewport. Collapse to a
         disclosure menu instead. -->
    <button
      type="button"
      class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-paper transition hover:border-signal md:hidden"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      <span class="sr-only">Toggle navigation</span>
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" />
      </svg>
      Menu
    </button>

    <nav id="primary-nav" aria-label="Primary" class="hidden md:block" data-nav>
      <ul class="flex flex-wrap items-center gap-4 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'rounded-full px-3 py-2 no-underline transition duration-200 hover:text-signal hover:bg-white/5',
                  isActive(link.href)
                    ? 'text-paper bg-white/5'
                    : 'text-muted',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/contact/"
            class="rounded-full border border-signal/20 bg-signal/10 px-4 py-2 text-sm font-semibold text-paper transition hover:bg-signal/15 hover:text-paper"
          >
            Work with me
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector('[data-nav-toggle]');
    const nav = document.querySelector('[data-nav]');
    if (!toggle || !nav) return;

    const isMobile = () => window.matchMedia('(max-width: 767px)').matches;

    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('hidden', !open);
      /* The open mobile panel spans the header's full width, below the row. */
      nav.classList.toggle('nav-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement && isMobile()) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    /* Crossing the breakpoint must not leave the desktop nav display:none. */
    window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches) {
        nav.classList.remove('hidden', 'nav-open');
        toggle.setAttribute('aria-expanded', 'false');
      } else if (toggle.getAttribute('aria-expanded') !== 'true') {
        nav.classList.add('hidden');
      }
    });
  })();
</script>

<style>
  @media (max-width: 767px) {
    .nav-open {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      border-bottom: 1px solid rgb(255 255 255 / 0.1);
      background: rgb(5 6 13 / 0.98);
      backdrop-filter: blur(16px);
      padding: 0.75rem 1.5rem 1.25rem;
    }

    .nav-open ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }

    .nav-open a {
      display: block;
      padding-block: 0.7rem;
    }
  }
</style>
