---
/**
 * Site-wide deep-space backdrop: parallax star layers that drift with the
 * pointer and the scroll position, plus the occasional meteor. Purely
 * decorative — never captures pointer events, and goes still under
 * prefers-reduced-motion.
 */
---

<canvas class="starfield" aria-hidden="true"></canvas>

<script is:inline>
  (() => {
    const canvas = document.querySelector('.starfield');
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const context = canvas.getContext('2d');
    if (!context) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Nearer layers are bigger, brighter, and parallax further. */
    const LAYERS = [
      { count: 90, depth: 0.18, size: 0.7, alpha: 0.42, drift: 1.6 },
      { count: 55, depth: 0.42, size: 1.1, alpha: 0.62, drift: 3.4 },
      { count: 28, depth: 0.75, size: 1.7, alpha: 0.85, drift: 6.0 },
    ];
    const TINTS = ['226, 232, 240', '186, 230, 253', '196, 181, 253'];

    let width = 0;
    let height = 0;
    let stars = [];

    function buildStars() {
      stars = [];
      LAYERS.forEach((layer) => {
        for (let i = 0; i < layer.count; i += 1) {
          stars.push({
            x: Math.random(),
            y: Math.random(),
            depth: layer.depth,
            drift: layer.drift,
            size: layer.size * (0.6 + Math.random() * 0.8),
            alpha: layer.alpha * (0.55 + Math.random() * 0.45),
            tint: TINTS[Math.floor(Math.random() * TINTS.length)],
            twinkleSpeed: 0.4 + Math.random() * 1.1,
            twinklePhase: Math.random() * Math.PI * 2,
          });
        }
      });
    }

    function resize() {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      /* clientWidth excludes the scrollbar; innerWidth does not, and the
         difference leaves the fixed canvas overhanging the layout viewport. */
      width = document.documentElement.clientWidth;
      height = document.documentElement.clientHeight;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
    }

    /* Pointer parallax, eased toward the target so it never snaps. */
    let pointerTargetX = 0;
    let pointerTargetY = 0;
    let pointerX = 0;
    let pointerY = 0;
    let scrollOffset = 0;

    window.addEventListener('pointermove', (event) => {
      pointerTargetX = (event.clientX / width - 0.5) * 2;
      pointerTargetY = (event.clientY / height - 0.5) * 2;
    }, { passive: true });

    window.addEventListener('scroll', () => {
      scrollOffset = window.scrollY;
    }, { passive: true });

    /* Meteors: rare, short, and always travelling down-left to up-right. */
    let meteors = [];
    let nextMeteor = 2 + Math.random() * 5;

    function spawnMeteor() {
      const speed = 340 + Math.random() * 260;
      const angle = Math.PI * (0.13 + Math.random() * 0.1);
      meteors.push({
        x: Math.random() * width * 0.7,
        y: Math.random() * height * 0.55,
        vx: Math.cos(angle) * speed,
        vy: -Math.sin(angle) * speed,
        life: 0,
        maxLife: 0.9 + Math.random() * 0.5,
        length: 60 + Math.random() * 90,
      });
    }

    function render(delta, elapsed) {
      context.clearRect(0, 0, width, height);

      pointerX += (pointerTargetX - pointerX) * Math.min(delta * 2.4, 1);
      pointerY += (pointerTargetY - pointerY) * Math.min(delta * 2.4, 1);

      stars.forEach((star) => {
        const parallaxX = -pointerX * star.drift * 3;
        const parallaxY = -pointerY * star.drift * 3 - scrollOffset * star.depth * 0.06;

        let y = (star.y * height + parallaxY) % height;
        if (y < 0) y += height;
        let x = (star.x * width + parallaxX) % width;
        if (x < 0) x += width;

        const twinkle = reduceMotion
          ? 1
          : 0.72 + 0.28 * Math.sin(elapsed * star.twinkleSpeed + star.twinklePhase);

        context.globalAlpha = star.alpha * twinkle;
        context.fillStyle = `rgb(${star.tint})`;
        context.beginPath();
        context.arc(x, y, star.size, 0, Math.PI * 2);
        context.fill();
      });

      if (!reduceMotion) {
        meteors = meteors.filter((meteor) => {
          meteor.life += delta;
          meteor.x += meteor.vx * delta;
          meteor.y += meteor.vy * delta;
          if (meteor.life > meteor.maxLife) return false;

          const fade = 1 - meteor.life / meteor.maxLife;
          const tailX = meteor.x - Math.sign(meteor.vx) * meteor.length;
          const tailY = meteor.y - Math.sign(meteor.vy) * meteor.length * 0.32;
          const gradient = context.createLinearGradient(meteor.x, meteor.y, tailX, tailY);
          gradient.addColorStop(0, `rgba(224, 242, 254, ${0.85 * fade})`);
          gradient.addColorStop(1, 'rgba(224, 242, 254, 0)');

          context.globalAlpha = 1;
          context.strokeStyle = gradient;
          context.lineWidth = 1.4;
          context.lineCap = 'round';
          context.beginPath();
          context.moveTo(tailX, tailY);
          context.lineTo(meteor.x, meteor.y);
          context.stroke();
          return true;
        });
      }

      context.globalAlpha = 1;
    }

    let frameId = 0;
    let lastTime = 0;
    let elapsed = 0;

    function frame(time) {
      const delta = lastTime ? Math.min((time - lastTime) / 1000, 0.05) : 0;
      lastTime = time;
      elapsed += delta;

      nextMeteor -= delta;
      if (nextMeteor <= 0) {
        spawnMeteor();
        nextMeteor = 6 + Math.random() * 12;
      }

      render(delta, elapsed);
      frameId = requestAnimationFrame(frame);
    }

    function start() {
      if (reduceMotion || frameId) return;
      lastTime = 0;
      frameId = requestAnimationFrame(frame);
    }

    function stop() {
      cancelAnimationFrame(frameId);
      frameId = 0;
    }

    function reset() {
      resize();
      buildStars();
      render(0, elapsed);
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(reset, 150);
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    reset();
    start();
  })();
</script>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
