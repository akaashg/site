---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SpaceHero from '../components/SpaceHero.astro';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const featured = allProjects.sort((a, b) => a.data.order - b.data.order).slice(0, 4);
---

<BaseLayout
  title="Akaash Garg"
  description="Full-stack systems architect. 17+ years designing real-time distributed systems — authoritative multiplayer, offline-first data pipelines, PostgreSQL and Node backends, and Unity clients that hold a 13.9ms frame budget."
>
  <!-- overflow-x-clip contains the decorative glow below, which sits -right-8
       outside the card and otherwise forces a horizontal scrollbar at ~1024px.
       `clip` (not `hidden`) avoids creating a scroll container. -->
  <section class="mx-auto max-w-6xl overflow-x-clip px-6 py-16 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_420px] lg:items-center">
     <div class="space-y-8 scroll-reveal" data-animate>
        <p class="font-mono text-xs uppercase tracking-[0.32em] text-signal">Full-stack systems architect · 2 Dude Studios</p>
        <h1 class="max-w-3xl text-5xl font-semibold leading-[1.04] tracking-tight text-paper sm:text-6xl">
          I build real-time systems end to end.
        </h1>
        <p class="max-w-2xl text-lg leading-8 text-muted">
          17+ years in software: a decade of full-stack web and product delivery, then six years of authoritative multiplayer on standalone hardware. I lead a 6-person team shipping a venue-scale VR arena, an enterprise training platform on PostgreSQL and Node, and an open-world Unity title on Steam.
        </p>

        <div class="grid gap-4 sm:grid-cols-2 xl:max-w-2xl">
         <div class="panel p-5 scroll-reveal" data-animate data-animate-delay="120">
            <p class="text-xs uppercase tracking-[0.28em] text-muted">Teams</p>
            <p class="mt-3 text-lg font-semibold text-paper">Product teams, studios, and enterprises</p>
          </div>
         <div class="panel p-5 scroll-reveal" data-animate data-animate-delay="180">
            <p class="text-xs uppercase tracking-[0.28em] text-muted">Focus</p>
            <p class="mt-3 text-lg font-semibold text-paper">Distributed architecture, real-time sync, and platform engineering</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-4">
          <a
            href="/projects/"
           class="rounded-full bg-signal px-6 py-3 text-sm font-semibold text-paper no-underline shadow-lg shadow-signal/10 transition hover:bg-signal-dark hover:text-paper scroll-reveal"
           data-animate
           data-animate-delay="240"
         >
           See the work
         </a>
         <a
           href="/contact/"
           class="rounded-full border border-white/10 bg-white/5 px-6 py-3 text-sm font-semibold text-paper no-underline transition hover:border-signal scroll-reveal"
           data-animate
           data-animate-delay="300"
         >
           Get in touch
         </a>
       </div>
     </div>

     <div class="relative scroll-reveal" data-animate data-animate-delay="140">
       <div class="glass-card p-8">
         <SpaceHero size={340} />
       </div>
       <div class="pointer-events-none absolute -right-8 -bottom-8 hidden rounded-full bg-signal/15 blur-3xl md:block h-24 w-24"></div>
     </div>
   </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
   <div class="glass-card p-6 md:p-8 scroll-reveal" data-animate data-animate-delay="80">
     <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
       <div>
         <p class="text-xs uppercase tracking-[0.3em] text-signal">Expertise</p>
         <h2 class="mt-3 text-2xl font-semibold text-paper">Real-time architecture, AI-native delivery, and technical leadership.</h2>
       </div>
       <a
         href="/contact/"
         class="inline-flex rounded-full bg-signal px-5 py-3 text-sm font-semibold text-paper shadow-lg shadow-signal/15 transition hover:bg-signal/90 hover:text-paper"
       >
         Let’s talk
       </a>
     </div>
     <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
       {[
         'One authoritative host, 8 clients',
         'Offline-first sync with crash recovery',
         '72fps standalone — 13.9ms budget',
         'Published Claude Code plugin for Unity',
         'Agent hooks that block unsafe edits',
         'Checks that gate every agent turn',
         'Technical lead, 6-person team',
         'Sprint and review process from zero',
       ].map((item, index) => (
         <div class="rounded-3xl border border-white/10 bg-white/5 px-4 py-4 scroll-reveal" data-animate data-animate-delay={index * 70 + 100}>
           <p class="text-sm font-medium text-paper">{item}</p>
         </div>
       ))}
     </div>
   </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
   <ul class="flex flex-wrap gap-3" aria-label="Core technical stack">
     {
       [
         'C#',
         'Unity 6',
         'Photon Fusion 2',
         'Node.js',
         'PostgreSQL',
         'React',
         'Supabase',
         'OpenXR',
       ].map((item, index) => (
         <li class="tag scroll-reveal" data-animate data-animate-delay={index * 70}>{item}</li>
       ))
     }
   </ul>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
   <div class="flex items-baseline justify-between scroll-reveal" data-animate data-animate-delay="60">
     <h2 class="text-xl font-semibold text-paper">What I am hired to own</h2>
     <a href="/services/" class="inline-block py-2 text-sm font-semibold text-signal transition hover:text-signal/90">What I do &rarr;</a>
   </div>
   <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
     {
       [
         { name: 'Systems architecture & design', detail: 'Authority models, data flow, and the decisions that are expensive to reverse.' },
         { name: 'Multiplayer & real-time systems', detail: 'Server-authoritative state, prediction, and holding the frame budget.' },
         { name: 'Backend & platform engineering', detail: 'PostgreSQL schemas, Node APIs, and offline-first sync.' },
         { name: 'XR application development', detail: 'VR and AR in Unity, shipped to standalone headsets and mobile.' },
         { name: 'Enterprise XR training & simulation', detail: 'Digital twins, branching scenarios, and scored outcomes.' },
         { name: 'Game development', detail: 'Unity games from prototype to Steam and mobile release.' },
       ].map((service, index) => (
         <a
           href="/services/"
           class="panel block p-5 no-underline transition hover:border-signal/40 scroll-reveal"
           data-animate
           data-animate-delay={index * 70 + 60}
         >
           <p class="text-base font-semibold text-paper">{service.name}</p>
           <p class="mt-2 text-sm leading-6 text-muted">{service.detail}</p>
         </a>
       ))
     }
   </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
   <div class="flex items-baseline justify-between scroll-reveal" data-animate data-animate-delay="60">
     <h2 class="text-xl font-semibold text-paper">Selected work</h2>
     <a href="/projects/" class="inline-block py-2 text-sm font-semibold text-signal transition hover:text-signal/90">All projects &rarr;</a>
   </div>
   <div class="mt-6 grid gap-6 sm:grid-cols-2">
     {featured.map((project, i) => <ProjectCard project={project} index={i + 1} />)}
   </div>
  </section>
</BaseLayout>
