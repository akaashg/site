---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Akaash Garg — lead XR engineer at 2 Dude Studios. 17+ years in software, currently focused on multiplayer XR simulation for medical, industrial, and enterprise training."
>
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-center lg:gap-12">
      <div class="space-y-8">
        <div class="space-y-4">
          <p class="font-mono text-xs uppercase tracking-[0.28em] text-signal">About</p>
          <h1 class="text-4xl font-semibold leading-[1.05] tracking-tight text-paper sm:text-5xl">
            Lead XR engineer and product technologist for enterprise and games.
          </h1>
        </div>
        <p class="max-w-prose text-base leading-8 text-muted sm:text-lg">
          I lead a 6-person XR studio building premium enterprise training, simulation, and game experiences. With 17+ years in software and 6 years specialized in XR, I ship Unity products that combine performance, polish, and real business outcomes.
        </p>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs uppercase tracking-[0.18em] text-muted">
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-signal" aria-hidden="true"></span>
            Available for new engagements
          </span>
          <span>Bangalore, India (IST) · Remote worldwide</span>
        </div>
      </div>

      <figure class="relative mx-auto w-full max-w-[300px] lg:mx-0">
        <div class="portrait-frame">
          <img
            src="/images/profile-picture/akaash-garg-portrait-280.webp"
            srcset="
              /images/profile-picture/akaash-garg-portrait-280.webp 280w,
              /images/profile-picture/akaash-garg-portrait-560.webp 560w
            "
            sizes="300px"
            width="280"
            height="448"
            alt="Akaash Garg, lead XR engineer, standing with his arms folded"
            class="portrait-image"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption class="portrait-hud" aria-hidden="true">
            <span>Akaash Garg</span>
            <span>Bangalore · IST</span>
          </figcaption>
        </div>
        <div class="pointer-events-none absolute -bottom-6 -left-6 hidden h-24 w-24 rounded-full bg-signal/15 blur-3xl md:block" aria-hidden="true"></div>
      </figure>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {[
        { label: 'Experience', value: '17+ years', detail: '6 of them specialized in XR' },
        { label: 'XR applications shipped', value: '15+', detail: 'Quest, HoloLens, Vive, and Varjo' },
        { label: 'Games shipped', value: '4', detail: 'Racing, casual, simulation, and VR' },
      ].map((item) => (
        <div class="panel flex flex-col p-5">
          <p class="text-xs uppercase tracking-[0.28em] text-muted">{item.label}</p>
          <p class="mt-3 text-2xl font-semibold text-paper">{item.value}</p>
          <p class="mt-2 text-sm leading-6 text-muted">{item.detail}</p>
        </div>
      ))}

      <a
        href="/Akaash-Garg-XR-Engineer-Resume.pdf"
        download
        class="flex flex-col rounded-[2rem] border border-signal/40 bg-signal/10 p-5 no-underline transition hover:border-signal hover:bg-signal/20"
      >
        <p class="text-xs uppercase tracking-[0.28em] text-signal">Résumé</p>
        <p class="mt-3 flex items-center gap-2 text-2xl font-semibold text-paper">
          Download
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12" />
            <path d="m7 12 5 5 5-5" />
            <path d="M5 21h14" />
          </svg>
        </p>
        <p class="mt-2 text-sm leading-6 text-muted">PDF · full experience and stack</p>
      </a>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.5fr_1fr]">
      <div class="space-y-6">
        <h2 class="text-2xl font-semibold text-paper">What I do</h2>
        <ul class="space-y-4 text-base leading-8 text-muted">
          <li>Hands-on Unity XR engineering for Quest, HoloLens, Varjo, and SteamVR.</li>
          <li>Multiplayer systems, real-time networking, and physics simulation tuned for headset budgets.</li>
          <li>Enterprise-grade AR/VR training, visualization, and AI-assisted workflow products.</li>
        </ul>
        <p class="text-base leading-8 text-muted">
          I pair product strategy with execution, shipping the actual application, backend systems, and performance optimizations — not just design or technical proposals.
        </p>
      </div>

      <div class="panel p-6">
        <h3 class="text-sm uppercase tracking-[0.28em] text-signal">Core strengths</h3>
        <ul class="mt-6 space-y-4 text-sm leading-7 text-muted">
          <li>Enterprise XR product development</li>
          <li>Multiplayer and real-time collaboration</li>
          <li>Performance engineering for standalone headsets</li>
          <li>Full-stack tooling, SaaS backends, and studio leadership</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 rounded-[2rem] border border-white/10 bg-white/5 p-8">
      <div class="space-y-4">
        <h2 class="text-2xl font-semibold text-paper">Why work with me</h2>
        <p class="text-base leading-8 text-muted">
          I help startups, enterprises, and agencies move XR products from prototype to launch with the stability, polish, and performance expected by demanding clients.
        </p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {['Enterprise XR', 'Multiplayer systems', 'AI-integrated experiences', 'Technical leadership'].map((item) => (
          <div class="rounded-3xl border border-white/10 bg-surface/90 px-4 py-4 text-sm leading-6 text-paper">{item}</div>
        ))}
      </div>
    </div>

    <section class="mt-14 space-y-8">
      <div>
        <h2 class="text-xl font-semibold text-paper">Career</h2>
        <ol class="mt-6 space-y-8 border-l-2 border-white/10 pl-6">
          <li class="relative">
            <span class="absolute -left-[29px] top-1 h-2.5 w-2.5 rounded-full bg-signal" aria-hidden="true"></span>
            <p class="font-mono text-xs uppercase tracking-[0.26em] text-muted">Jul 2023 — Present</p>
            <h3 class="mt-2 text-base font-semibold text-paper">Lead XR Engineer, 2 Dude Studios</h3>
            <p class="mt-2 text-sm leading-7 text-muted">Lead a 6-person delivery team shipping enterprise training, simulation, and game experiences, with live arena VR deployed in 3 commercial venues and a Steam demo ready for Early Access.</p>
          </li>
          <li class="relative">
            <span class="absolute -left-[29px] top-1 h-2.5 w-2.5 rounded-full bg-white/10" aria-hidden="true"></span>
            <p class="font-mono text-xs uppercase tracking-[0.26em] text-muted">Mar 2023 — Jul 2023</p>
            <h3 class="mt-2 text-base font-semibold text-paper">Lead VR Developer, Witzeal Technologies</h3>
            <p class="mt-2 text-sm leading-7 text-muted">Delivered a multiplayer Quest VR extension for a 50M+ mobile platform in three months with zero critical post-launch defects.</p>
          </li>
          <li class="relative">
            <span class="absolute -left-[29px] top-1 h-2.5 w-2.5 rounded-full bg-white/10" aria-hidden="true"></span>
            <p class="font-mono text-xs uppercase tracking-[0.26em] text-muted">Jan 2022 — Dec 2022</p>
            <h3 class="mt-2 text-base font-semibold text-paper">Lead Unity Developer, CodeXAR</h3>
            <p class="mt-2 text-sm leading-7 text-muted">Led a 5-person team building a real-time AR design-review platform with high-fidelity rendering on mobile hardware.</p>
          </li>
          <li class="relative">
            <span class="absolute -left-[29px] top-1 h-2.5 w-2.5 rounded-full bg-white/10" aria-hidden="true"></span>
            <p class="font-mono text-xs uppercase tracking-[0.26em] text-muted">2009 — 2021</p>
            <h3 class="mt-2 text-base font-semibold text-paper">Founder & Lead Developer, Cyber Cerebs</h3>
            <p class="mt-2 text-sm leading-7 text-muted">Grew a digital studio from solo operation to an eight-person team, shipping 50+ products across hospitality, sports, travel, and logistics.</p>
          </li>
        </ol>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-paper">Stack</h2>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technical stack">
          {
            [
              'Unity 3D',
              'C#',
              'OpenXR',
              'AR Foundation',
              'XR Interaction Toolkit',
              'Meta XR SDK',
              'MRTK',
              'ARKit / ARCore',
              'URP / HDRP',
              'ShaderGraph / HLSL',
              'Photon Fusion',
              'Photon PUN',
              'Mirror',
              'PERN stack',
              'Node.js',
              'PostgreSQL',
              'Python',
            ].map((item) => <li class="tag">{item}</li>)
          }
        </ul>
      </div>
    </section>

    <div class="mt-14 rounded-[2rem] border border-white/10 bg-white/5 p-8">
      <h2 class="text-2xl font-semibold text-paper">Work with me</h2>
      <p class="mt-4 max-w-prose text-base leading-8 text-muted">
        Open to senior roles, contract engagements, and retained XR engineering for teams that need a founder-level technical lead and execution partner.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/contact/" class="rounded-full bg-signal px-5 py-3 text-sm font-semibold text-paper transition hover:bg-signal/90 hover:text-paper">Contact me</a>
        <a href="mailto:akaash.garg@gmail.com" class="rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-paper transition hover:border-signal">Email directly</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Same slate + violet wash as the home-page orbit viewer, so the portrait
     reads as part of the hero system rather than a pasted-in photo. The lift
     also matters for legibility: the cutout is a black t-shirt, which would
     disappear against the near-black page background. */
  .portrait-frame {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid rgb(125 211 252 / 0.15);
    background:
      radial-gradient(circle at 50% 34%, rgb(51 65 85 / 0.8), rgb(5 6 13 / 0.2) 64%),
      radial-gradient(circle at 78% 12%, rgb(124 58 237 / 0.3), transparent 52%);
    box-shadow: 0 24px 120px rgb(124 58 237 / 0.14);
    /* Headroom above the head; the figure bleeds off the bottom edge. */
    padding-top: 2rem;
  }

  .portrait-image {
    display: block;
    width: 100%;
    height: auto;
    /* Violet rim separates the dark silhouette from the frame. */
    filter: drop-shadow(0 0 22px rgb(124 58 237 / 0.45));
  }

  /* Grounds the bottom crop so the figure fades into the frame instead of
     ending on a hard cut. */
  .portrait-frame::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 22%;
    background: linear-gradient(to top, rgb(5 6 13 / 0.75), transparent);
    pointer-events: none;
  }

  .portrait-hud {
    position: absolute;
    inset: auto 1rem 0.9rem;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font: 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(186 230 253 / 0.7);
  }

  .portrait-hud span:last-child {
    color: rgb(167 139 250 / 0.72);
  }
</style>
