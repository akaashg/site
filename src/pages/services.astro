---
import BaseLayout from '../layouts/BaseLayout.astro';

const CAL_URL = 'https://cal.com/akaash-garg-xvijkt/hi';

/* Numbering is derived from position so adding a service never desyncs the ids. */
const services = [
  {
    name: 'Systems architecture & design',
    lead: 'The decisions that are expensive to reverse, made deliberately and written down.',
    detail:
      'State ownership and authority models, coordinate and reference frames, service boundaries, schema and data-flow design, and failure and recovery behaviour. Delivered as a written architecture document that records the options considered and the constraint that settled each one — so the reasoning survives after I leave.',
    proof: 'One authoritative host owning all state for eight standalone clients in a shared physical space.',
  },
  {
    name: 'Backend & platform engineering',
    lead: 'The half of a real-time product that is not the client.',
    detail:
      'PostgreSQL schema design, Node and Express APIs, multi-tenant models, auth and role boundaries, offline-first ingestion with retry and reconciliation, React operator dashboards, and CI and edge deployment pipelines.',
    proof: 'Offline-first telemetry: disk queue, backoff, and crash-journal reconciliation on relaunch.',
  },
  {
    name: 'VR application development',
    lead: 'Multiplayer and single-user VR products built in Unity, shipped to standalone headsets.',
    detail:
      'Free-roam and room-scale experiences, instructor-led training, simulation, and location-based entertainment. Delivered on Meta Quest 2/3/Pro, HTC Vive, Varjo, and SteamVR.',
    proof: 'Free-roam arena software for 8 co-located players, built to a 72fps standalone budget.',
  },
  {
    name: 'AR application development',
    lead: 'Mobile and headset AR for product visualization, design review, and field work.',
    detail:
      'AR Foundation, ARKit, and ARCore on iOS and Android, plus HoloLens and passthrough MR. Includes photogrammetry capture-to-runtime pipelines, spatial anchors, and hand tracking.',
    proof: 'CollaboratAR held 8K source texture fidelity on mobile hardware.',
  },
  {
    name: 'Multiplayer systems engineering',
    lead: 'Networked architecture that stays synchronized under real-world latency.',
    detail:
      'Photon Fusion, Photon PUN, and Mirror. Server-authoritative state, client-side prediction and interpolation, reconciliation, latency compensation, and dedicated server hosting.',
    proof: 'Sub-100ms latency bridging a Unity VR client to a proprietary Java backend.',
  },
  {
    name: 'XR performance optimization',
    lead: 'Getting an existing build inside the frame budget it keeps missing.',
    detail:
      'GPU and CPU profiling with Unity Profiler and RenderDoc, draw-call batching, LOD systems, texture atlasing, Draco mesh compression, object pooling and GC pressure, custom HLSL and ShaderGraph work across URP and HDRP.',
    proof: 'Standalone Quest builds held to a 72fps budget with physics, AI, and avatar sync.',
  },
  {
    name: 'Game development',
    lead: 'Unity games from prototype to store release, on PC and mobile.',
    detail:
      'Gameplay systems, procedural generation, wildlife and enemy AI, animation state machines, custom shaders, and the full Steamworks pipeline through build, depot, store page, and age-rating submission. Shipped across racing, roguelite, RPG, simulation, survival, and runner genres.',
    proof: 'Ruins of the Forgotten: public Steam demo live, Early Access Q3 2026.',
  },
  {
    name: 'Enterprise XR training products',
    lead: 'Turning regulatory and operational curricula into rehearsable scenarios.',
    detail:
      'Branching decision paths, performance scoring, digital twins of real facilities and equipment, SOP and hazard modules, LMS/HRMS integration, and offline deployment for remote sites.',
    proof: 'Multi-user VR team training built for logistics, manufacturing, and safety drills.',
  },
  {
    name: 'Gamified training solutions',
    lead: 'Game mechanics applied to training people actually finish.',
    detail:
      'Regulatory and compliance curricula rebuilt as branching scenario modules with performance scoring, progression, and measurable outcomes — replacing slide-based courseware with situations a trainee rehearses rather than reads.',
    proof: 'Gamified VR compliance training delivered in place of slide-based courseware.',
  },
  {
    name: 'Technical leadership & architecture',
    lead: 'Founder-level ownership when a team needs direction, not just hands.',
    detail:
      'Architecture decisions, code review, sprint planning, hiring input, vendor and client communication, and delivery accountability. Available as fractional lead alongside an in-house team.',
    proof: 'Leads a 6-person delivery team across three concurrent products.',
  },
];

const engagements = [
  {
    name: 'Full-time contract',
    best: 'A team that needs another senior engineer on the roadmap.',
    shape:
      'Four to five days a week, embedded in your team - your repository, your planning, your review process. Rolling monthly with a month of notice either way.',
  },
  {
    name: 'Part-time contract',
    best: 'Specialist depth you do not need every day.',
    shape:
      'Two or three days a week on a fixed schedule, so the overlap is predictable rather than best-effort.',
  },
  {
    name: 'Architecture & design sprint',
    best: 'A system that has not been built yet.',
    shape:
      'One to three weeks ahead of implementation, producing the authority model, data design, and a written decision record your team builds against.',
  },
  {
    name: 'Fixed-scope project',
    best: 'A defined deliverable with a deadline.',
    shape: 'Scoped brief, milestone schedule, fixed price. Best when the requirements are already clear.',
  },
];

const domains = [
  'Manufacturing',
  'Logistics',
  'Healthcare & medical simulation',
  'Location-based entertainment',
  'Retail & product visualization',
  'Games & interactive',
];

const faqs = [
  {
    q: 'Are you hands-on, or do you pass the work to a team?',
    a: 'Hands-on, every day. I write the code I design. On a contract I am the one doing the work — you are not buying a fraction of divided attention, and nothing is quietly handed to someone else.',
  },
  {
    q: 'How much overlap do I get with your working day?',
    a: 'I am in Bangalore (IST) and hold a standing overlap with European hours, with a shorter window for US Eastern. Tell me the hours your team actually needs and I will say plainly whether I can hold them.',
  },
  {
    q: 'Do you work inside our repository and our process?',
    a: 'Yes — your repository, your branching model, your review process, your planning and standups. I bring the engineering, not a parallel way of working for you to accommodate.',
  },
  {
    q: 'How do contracting and invoicing work?',
    a: 'Either as an individual or through my company, whichever suits your procurement. Monthly invoicing in arrears, under your contract and NDA.',
  },
  {
    q: 'Which stacks and platforms do you work in?',
    a: 'Node, PostgreSQL and React on the platform side; Unity and C# on the client, across Meta Quest 2/3/Pro, HoloLens, Vive, Varjo, SteamVR, iOS and Android. Steam releases include the full Steamworks pipeline.',
  },
  {
    q: 'Who owns the code and the IP?',
    a: 'You do. Work transfers in full on delivery, and contracts run under your paperwork and NDA.',
  },
  {
    q: 'How soon can you start?',
    a: 'Tell me the date you are working towards and I will tell you honestly whether I can meet it, rather than committing and renegotiating afterwards.',
  },
];
---

<BaseLayout
  title="What I do"
  description="What Akaash Garg is hired to own: real-time and distributed system design, PostgreSQL and Node backends, authoritative multiplayer, performance optimization, and Unity VR and AR development - full-time or part-time contract, remote."
>
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <div class="space-y-6 scroll-reveal" data-animate>
      <p class="font-mono text-xs uppercase tracking-[0.28em] text-signal">What I do</p>
      <h1 class="max-w-4xl text-4xl font-semibold leading-[1.05] tracking-tight text-paper sm:text-5xl">
        What I am hired to own.
      </h1>
      <p class="max-w-prose text-base leading-8 text-muted sm:text-lg">
        I take on the work that decides whether a real-time product launches: who owns state and what
        crosses the wire, a data layer that holds up when the network does not, and clients that stay
        inside their budget. I write the architecture and then build it — hands-on, every day, in your
        repo and your process. Ten areas below, and four ways to work together.
      </p>
      <div class="flex flex-wrap gap-4 pt-2">
        <a
          href={CAL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-signal px-6 py-3 text-sm font-semibold text-paper no-underline shadow-lg shadow-signal/15 transition hover:bg-signal-dark hover:text-paper"
        >
          Book an intro call
        </a>
        <a
          href="/contact/#brief"
          class="rounded-full border border-white/10 bg-white/5 px-6 py-3 text-sm font-semibold text-paper no-underline transition hover:border-signal"
        >
          Send a role description
        </a>
      </div>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {services.map((service, index) => (
        <article class="glass-card flex flex-col p-6 scroll-reveal" data-animate data-animate-delay={index * 80}>
          <p class="font-mono text-xs tracking-[0.3em] text-signal">{String(index + 1).padStart(2, '0')}</p>
          <h2 class="mt-4 text-xl font-semibold text-paper">{service.name}</h2>
          <p class="mt-3 text-base leading-7 text-paper">{service.lead}</p>
          <p class="mt-3 flex-1 text-sm leading-7 text-muted">{service.detail}</p>
          <p class="mt-5 border-t border-white/10 pt-4 font-mono text-xs leading-6 uppercase tracking-[0.14em] text-signal">
            {service.proof}
          </p>
        </article>
      ))}
    </div>

    <div class="mt-16 scroll-reveal" data-animate>
      <h2 class="text-2xl font-semibold text-paper">How I work with your team</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {engagements.map((item) => (
          <div class="panel flex flex-col p-6">
            <h3 class="text-base font-semibold text-paper">{item.name}</h3>
            <p class="mt-3 font-mono text-xs uppercase tracking-[0.18em] text-signal">{item.best}</p>
            <p class="mt-4 text-sm leading-7 text-muted">{item.shape}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 max-w-prose text-sm leading-7 text-muted">
        Rate depends on the commitment level, the expected length, and the overlap hours you need.
        Bring those to the first call and you get a figure on that call — not a range that moves later.
      </p>
    </div>

    <div class="mt-16 glass-card p-8 scroll-reveal" data-animate>
      <h2 class="text-2xl font-semibold text-paper">Domains I have shipped in</h2>
      <ul class="mt-6 flex flex-wrap gap-3" aria-label="Domains shipped in">
        {domains.map((item) => <li class="tag">{item}</li>)}
      </ul>
    </div>

    <div class="mt-16 scroll-reveal" data-animate>
      <h2 class="text-2xl font-semibold text-paper">Common questions</h2>
      <dl class="mt-6 space-y-4">
        {faqs.map((faq) => (
          <div class="panel p-6">
            <dt class="text-base font-semibold text-paper">{faq.q}</dt>
            <dd class="mt-3 text-sm leading-7 text-muted">{faq.a}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="mt-16 glass-card p-8 text-center scroll-reveal" data-animate>
      <h2 class="text-2xl font-semibold text-paper">Looking at a role?</h2>
      <p class="mx-auto mt-4 max-w-prose text-base leading-8 text-muted">
        Send the role description, the stack, and the overlap hours you need. If I am not the right fit,
        I will say so on the first call rather than three weeks in.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href={CAL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-signal px-6 py-3 text-sm font-semibold text-paper no-underline shadow-lg shadow-signal/15 transition hover:bg-signal-dark hover:text-paper"
        >
          Book an intro call
        </a>
        <a
          href="/projects/"
          class="rounded-full border border-white/10 bg-white/5 px-6 py-3 text-sm font-semibold text-paper no-underline transition hover:border-signal"
        >
          See the case studies
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
