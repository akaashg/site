# Cloudflare Pages reads this file from the build output root.
# Rules are matched top-to-bottom; the most specific match wins.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Astro fingerprints these filenames, so they can be cached indefinitely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Screenshots and cards change only when the generator scripts are re-run.
/images/*
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000

# HTML must revalidate so content edits go live on the next request.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
